# Shared base image for the sdnotify integration tests.
#
# The build stage uses the pinned OpenTelemetry Collector Builder (OCB) image to
# assemble a minimal collector containing the sdnotify extension (built from
# local source) plus the components the test configs use. See
# testdata/builder-config.yaml for the distribution definition.
FROM ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-builder:0.159.0 AS build-stage

WORKDIR /src
# Repo root is the build context (see the test's FromDockerfile.Context: "../..").
COPY . /src

# The builder-config's `replaces` directive resolves the extension module to
# /src/extension/sdnotifyextension, so the built binary contains the local code.
RUN ocb --config /src/extension/sdnotifyextension/testdata/builder-config.yaml

# Minimal systemd runtime shared by every scenario. Scenario Dockerfiles add
# their own config.yaml and otelcol.service on top of this. The fauust image
# ships systemd preconfigured as PID 1 (CMD=/lib/systemd/systemd).
FROM ghcr.io/fauust/docker-systemd:debian-13

# The otlp exporter dials over TLS, which needs the CA bundle; the base image
# does not ship it.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build-stage /home/ocb/build/otelcol /bin/otelcol

# To allow systemd (and other programs) to identify that it is executed within
# a container, please set the $container environment variable for PID 1 in the
# container to a short lowercase string identifying your implementation.
# https://github.com/systemd/systemd/blob/main/docs/CONTAINER_INTERFACE.md#environment-variables
ENV container=docker

# If the container manager wants to cleanly shut down the container, it might be
# a good idea to send SIGRTMIN+3 to its init process. systemd will then do a clean shutdown.
# https://github.com/systemd/systemd/blob/main/docs/CONTAINER_INTERFACE.md#advanced-integration
STOPSIGNAL SIGRTMIN+3
