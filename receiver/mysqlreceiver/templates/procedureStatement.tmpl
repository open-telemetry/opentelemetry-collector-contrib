SELECT
    COALESCE(`object_schema`, ''),
    `object_name`,
    LOWER(`object_type`),
    `sql_text`,
    `timer_end`,
    `timer_wait`,
{{- if .supportsCPUTime }}
    COALESCE(`cpu_time`, 0),
{{- else }}
    0,
{{- end }}
    `rows_examined`,
    `rows_sent`,
    `rows_affected`
FROM performance_schema.events_statements_history
WHERE `nesting_event_id` IS NOT NULL
    AND `object_type` IN ('PROCEDURE', 'FUNCTION')
    AND `object_name` IS NOT NULL
    AND `sql_text` IS NOT NULL
    AND `end_event_id` IS NOT NULL
ORDER BY `timer_end` DESC
LIMIT {{ .limit }}
