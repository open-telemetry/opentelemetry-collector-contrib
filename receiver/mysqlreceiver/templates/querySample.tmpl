/* otel-collector-ignore */ SELECT
    thread.processlist_id AS session_id,
    thread.thread_id AS internal_thread_id,
    COALESCE(thread.processlist_user, '') AS session_user,
    COALESCE(
        {{- if .supportsProcesslist}} pl.HOST,{{- end}}
        thread.processlist_host, ''
    ) AS client_address,
    -- client_port is parsed from client_address in Go using net.SplitHostPort,
    -- which handles both IPv4 (host:port) and IPv6 ([::1]:port) formats correctly.
    -- pl.HOST contains "host:port" for TCP/IP connections on MySQL 8.0.22+.
    0 AS client_port,
    COALESCE(thread.processlist_db, '') AS current_database,
    COALESCE(thread.processlist_command, '') AS session_command,
    COALESCE(thread.processlist_state, '') AS session_state,
    COALESCE(statement.DIGEST_TEXT, statement.sql_text, COALESCE(thread.PROCESSLIST_info, '')) AS digest_text,
    COALESCE(statement.sql_text, COALESCE(thread.PROCESSLIST_info, '')) AS sql_text,
    COALESCE(statement.digest, '') AS fingerprint,
    COALESCE(wait.event_id, statement.event_id, 0) AS activity_event_id,
    CASE
        {{- if .supportsDataLockWaits}}
        -- A session that is idle itself but holds a lock someone else wants. It
        -- only reaches this query through the blocker branch of the WHERE clause
        -- (the main predicates exclude 'Sleep' and 'Daemon'), so any such row is
        -- a blocker rather than ordinary activity. Reported explicitly, instead
        -- of the 'waiting' its idle wait row would otherwise produce, so
        -- consumers counting active sessions can exclude it without having to
        -- infer idleness from processlist_command. SQL Server reports the same
        -- case as command 'IDLE_BLOCKER'.
        WHEN thread.processlist_command IN ('Sleep', 'Daemon') THEN 'idle_blocker'
        {{- end}}
        WHEN wait.thread_id IS NOT NULL
            AND wait.end_event_id IS NULL THEN 'waiting'
        -- actively executing on CPU
         WHEN statement.thread_id IS NOT NULL
              AND COALESCE(statement.sql_text, thread.processlist_info) <> '' THEN 'running'
        -- fallback
        ELSE 'other'
    END AS session_status,
    IF(wait.thread_id IS NULL,
        'other',
        COALESCE(
            IF(thread.processlist_state = 'User sleep', 'User sleep',
            IF(wait.event_id = wait.end_event_id, 'CPU', wait.event_name)), 'CPU'
        )
    ) AS wait_type,
    -- wait_event_type is the top-level classification from EVENT_NAME's second
    -- path segment ('io' | 'lock' | 'synch'). Gated on the exact same
    -- conditions as session_status above so this only reports a real category
    -- while session_status = 'waiting'; it reports 'CPU' in lockstep with
    -- 'running', and 'other' in lockstep with 'other'. A NULL wait.event_name
    -- on a genuinely waiting row is guarded by the outer COALESCE so this
    -- column is never NULL.
    CASE
        WHEN wait.thread_id IS NOT NULL AND wait.end_event_id IS NULL THEN
            COALESCE(
                IF(thread.processlist_state = 'User sleep', 'User sleep',
                   SUBSTRING_INDEX(SUBSTRING_INDEX(wait.event_name, '/', 2), '/', -1)),
                'other'
            )
        WHEN statement.thread_id IS NOT NULL
             AND COALESCE(statement.sql_text, thread.processlist_info) <> '' THEN 'CPU'
        ELSE 'other'
    END AS wait_event_type,
    -- wait_event is everything after the category segment of EVENT_NAME
    -- (subsystem/component/instrument), e.g. 'table/sql/handler',
    -- 'mutex/innodb/checkpoint_state'. Same session_status-aligned gating and
    -- NULL-safety as wait_event_type above.
    CASE
        WHEN wait.thread_id IS NOT NULL AND wait.end_event_id IS NULL THEN
            COALESCE(
                IF(thread.processlist_state = 'User sleep', 'User sleep',
                   SUBSTRING(wait.event_name, LENGTH(SUBSTRING_INDEX(wait.event_name, '/', 2)) + 2)),
                'other'
            )
        WHEN statement.thread_id IS NOT NULL
             AND COALESCE(statement.sql_text, thread.processlist_info) <> '' THEN 'CPU'
        ELSE 'other'
    END AS wait_event,
    COALESCE(
        -- Tier 1: completed wait event — TIMER_WAIT is populated (exact, picosecond precision)
        wait.timer_wait / 1e12,

        -- Tier 2: in-progress wait — approximate elapsed time from PS timers (sub-second).
        -- statement.TIMER_WAIT is live for in-progress statements on MySQL 5.7+/8.0+.
        -- On MariaDB, statement.TIMER_WAIT may be 0 or stale during active execution,
        -- so the guard (statement.timer_wait > 0) causes MariaDB to fall through to Tier 3.
        -- Math: statement.TIMER_START + statement.TIMER_WAIT ≈ current PS clock, so
        -- elapsed_wait = current_ps_time - wait.TIMER_START. Clamped via GREATEST to
        -- guard against microsecond read-order skew.
        CASE
            WHEN wait.end_event_id IS NULL
                 AND wait.timer_start IS NOT NULL
                 AND statement.timer_start IS NOT NULL
                 AND statement.timer_wait > 0
            THEN GREATEST(
                     (statement.timer_start + statement.timer_wait - wait.timer_start) / 1e12,
                     0)
            ELSE NULL
        END,

        -- Tier 3: processlist_time fallback (integer second precision).
        -- threads.PROCESSLIST_TIME resets on each processlist_state change, so it
        -- represents elapsed seconds in the current state — semantically correct for
        -- lock/IO waits. Always available on MySQL 5.7+ and all MariaDB 10.x.
        CASE
            WHEN wait.thread_id IS NOT NULL AND wait.end_event_id IS NULL
            THEN CAST(thread.processlist_time AS DECIMAL(20, 6))
            ELSE NULL
        END,

        0
    ) AS wait_time_seconds,
    COALESCE(statement.TIMER_WAIT/1e12, thread.processlist_time, 0) AS statement_timer_wait_seconds,
    -- Extension: Get @traceparent from user_variables_by_thread.
    -- This table is available on MySQL 5.7.3+ and MariaDB 10.5.2+.
    -- Use CONVERT for MySQL 8.0+ which stores user variables as binary (VARBINARY);
    -- on MySQL 5.7 and MariaDB the value is VARCHAR, so CONVERT is a no-op.
    -- utf8mb4 is used instead of the deprecated utf8 alias.
    COALESCE(CONVERT(uvt.VARIABLE_VALUE USING utf8mb4), '') AS traceparent,
    -- client_name is the client driver's self-reported identity
    -- (e.g. "MySQL Connector/J", "libmysql"), joined on PROCESSLIST_ID (not
    -- thread_id -- a different ID space) and filtered to one ATTR_NAME so
    -- the join stays 1:1, same pattern as the user_variables_by_thread join
    -- below for @traceparent.
    COALESCE(attrs.ATTR_VALUE, '') AS client_name,
    {{- if .supportsDataLockWaits}}
    -- blocker_details is a JSON array of {thread_id, session_id} tuples, one
    -- entry per concurrent InnoDB row-lock blocker for this thread. LEFT JOIN
    -- means a blocker that has already disconnected still appears (thread_id
    -- populated, session_id null) instead of vanishing. Unordered -- do not
    -- join information_schema.INNODB_TRX to sort oldest-transaction-first:
    -- that table requires the global PROCESS privilege, and MySQL checks
    -- privileges on every referenced table at prepare time regardless of
    -- whether a row is actually needed, so the entire query would fail
    -- outright for any monitoring user without PROCESS the moment a real
    -- block existed. DISTINCT collapses duplicate rows data_lock_waits can
    -- produce when the same blocker holds multiple conflicting lock
    -- structures against this thread's single wait, so blocker.count
    -- reflects distinct blocking sessions, not lock rows.
    COALESCE(
        (
            SELECT JSON_ARRAYAGG(JSON_OBJECT('thread_id', ordered.thread_id, 'session_id', ordered.session_id))
            FROM (
                SELECT DISTINCT lw.BLOCKING_THREAD_ID AS thread_id, bt.PROCESSLIST_ID AS session_id
                FROM performance_schema.data_lock_waits AS lw
                LEFT JOIN performance_schema.threads AS bt ON bt.THREAD_ID = lw.BLOCKING_THREAD_ID
                WHERE lw.REQUESTING_THREAD_ID = thread.thread_id
            ) AS ordered
        ), '[]'
    )
    {{- else}}
    -- blocker_details is unavailable on MySQL <8.0.11 and MariaDB: the only way
    -- to identify a blocking session's thread/session ID on these versions is
    -- information_schema.INNODB_TRX/INNODB_LOCK_WAITS, both of which require the
    -- global PROCESS privilege (confirmed via live testing against MySQL 5.7.44
    -- and MariaDB 10.5.29) -- the same PROCESS dependency avoided above.
    -- Reporting an empty string (not "[]") keeps "not measured" distinguishable
    -- from "measured and not blocked", while still keeping the rest of this
    -- event intact for monitoring users without that privilege, rather than
    -- failing the whole query.
    ''
    {{- end}} AS blocker_details,
    {{- if .supportsDataLockWaits}}
    -- The lock this session is waiting to acquire, from its own pending request
    -- row in data_locks (see the requested_lock join below). LOCK_DATA is
    -- deliberately not selected: it holds the primary-key values of the locked
    -- record, which is customer data and would need obfuscating.
    COALESCE(requested_lock.LOCK_MODE, '') AS blocking_lock_mode,
    COALESCE(requested_lock.LOCK_TYPE, '') AS blocking_lock_type,
    COALESCE(requested_lock.OBJECT_SCHEMA, '') AS blocking_object_schema,
    COALESCE(requested_lock.OBJECT_NAME, '') AS blocking_object_name,
    -- blocking_statement_timer_start is picoseconds since server start at which
    -- the waiting statement began; Go converts it to a wall-clock timestamp
    -- against a server boot time cached across scrapes. InnoDB's only exact lock
    -- wait start is information_schema.INNODB_TRX.trx_wait_started, which needs
    -- the global PROCESS privilege this receiver avoids depending on, so the
    -- statement start stands in for it -- it is at or before the lock wait
    -- itself began. Reporting TIMER_START rather than a per-scrape
    -- UTC_TIMESTAMP() - elapsed subtraction is what makes the value stable
    -- across scrapes, so consumers can correlate repeated reads of one wait.
    CASE
        WHEN requested_lock.ENGINE_LOCK_ID IS NOT NULL
        THEN COALESCE(statement.timer_start, 0)
        ELSE 0
    END AS blocking_statement_timer_start,
    -- Whole seconds the waiting statement has been executing, on the same
    -- statement-start basis as blocking_statement_timer_start so the two agree.
    CASE
        WHEN requested_lock.ENGINE_LOCK_ID IS NOT NULL
        THEN FLOOR(COALESCE(statement.timer_wait, 0) / 1e12)
        ELSE 0
    END AS blocking_wait_duration
    {{- else}}
    -- Lock wait detail shares blocker_details' PROCESS dependency on
    -- MySQL <8.0.11 and MariaDB, so it reports the same "not measured"
    -- values -- empty string and 0 -- rather than failing the whole query.
    '' AS blocking_lock_mode,
    '' AS blocking_lock_type,
    '' AS blocking_object_schema,
    '' AS blocking_object_name,
    0 AS blocking_statement_timer_start,
    0 AS blocking_wait_duration
    {{- end}}
FROM
    performance_schema.threads AS thread
    LEFT JOIN performance_schema.events_statements_current AS statement ON statement.thread_id = thread.thread_id
    LEFT JOIN performance_schema.events_waits_current AS wait ON wait.thread_id = thread.thread_id
    -- Extension: Join user_variables_by_thread to get @traceparent.
    -- Available on MySQL 5.7.3+ and MariaDB 10.5.2+; this template is used for both.
    -- Both MySQL and MariaDB store user variable names in lowercase in VARIABLE_NAME
    -- regardless of how the client spelled them, so '= traceparent' matches any case.
    LEFT JOIN performance_schema.user_variables_by_thread AS uvt ON uvt.thread_id = thread.thread_id AND uvt.VARIABLE_NAME = 'traceparent'
    LEFT JOIN performance_schema.session_connect_attrs AS attrs ON attrs.PROCESSLIST_ID = thread.PROCESSLIST_ID AND attrs.ATTR_NAME = '_client_name'
    {{- if .supportsDataLockWaits}}
    -- requested_lock is this thread's own pending lock request, reached through
    -- data_lock_waits.REQUESTING_ENGINE_LOCK_ID. Unlike the blocker side, this
    -- cannot fan out the sample: ENGINE_LOCK_ID is unique in data_locks and a
    -- transaction waits on exactly one lock request at a time, so the join is
    -- 1:0..1. MIN() only forces the correlated subquery to a single value --
    -- every data_lock_waits row for one waiter repeats the same requesting id,
    -- one row per blocker holding a conflicting lock.
    LEFT JOIN performance_schema.data_locks AS requested_lock
        ON requested_lock.ENGINE_LOCK_ID = (
            SELECT MIN(requesting_wait.REQUESTING_ENGINE_LOCK_ID)
            FROM performance_schema.data_lock_waits AS requesting_wait
            WHERE requesting_wait.REQUESTING_THREAD_ID = thread.thread_id
        )
    {{- end}}
    {{- if .supportsProcesslist}}
    -- performance_schema.processlist.HOST returns "host:port" for TCP/IP connections,
    -- enabling population of client.port. Available MySQL 8.0.22+; lock-free unlike
    -- information_schema.PROCESSLIST (which was removed in MySQL 9.0).
    LEFT JOIN performance_schema.processlist AS pl ON pl.ID = thread.PROCESSLIST_ID
    {{- end}}
WHERE
    (
        (
            thread.processlist_state IS NOT NULL
            AND thread.processlist_command NOT IN ('Sleep', 'Daemon')
            AND (wait.EVENT_NAME != 'idle' OR wait.EVENT_NAME IS NULL)
            AND (wait.operation != 'idle' OR wait.operation IS NULL)
            AND COALESCE(statement.sql_text, thread.PROCESSLIST_info) != ''
        )
        {{- if .supportsDataLockWaits}}
        -- The classic row-lock blocker is idle in the middle of a transaction:
        -- no processlist_state, command 'Sleep', an 'idle' wait and often no
        -- current statement text, so it fails every predicate above and would
        -- never be sampled. Without a sample of its own, consumers can resolve
        -- a blocker's thread and session id from blocker_details but nothing
        -- else, and the blocker shows up as an unknown session. Admitting any
        -- thread that appears as a blocker fixes that, and the branch has to sit
        -- outside the group above rather than being ANDed into it, or it is dead
        -- code. The blocker's statement text comes from the row
        -- events_statements_current keeps after a statement completes, i.e. the
        -- last thing the blocker ran, matching what SQL Server reports from
        -- most_recent_sql_handle and Oracle from PREV_SQL_ID.
        OR thread.thread_id IN (
            SELECT blocking_wait.BLOCKING_THREAD_ID
            FROM performance_schema.data_lock_waits AS blocking_wait
        )
        {{- end}}
    )
    AND thread.processlist_id != CONNECTION_ID()
    -- events_waits_current can have multiple rows per thread, thus we use EVENT_ID to identify the row we want to use.
    -- Additionally, we want the row with the highest EVENT_ID which reflects the most recent and current wait.
    AND (
        wait.event_id = (
           SELECT
              MAX(current_waits.EVENT_ID)
          FROM  performance_schema.events_waits_current AS current_waits
          Where current_waits.thread_id = thread.thread_id
    ) OR wait.event_id is NULL)
    -- Defaulted to '' because an idle blocker admitted by the branch above can
    -- have no statement text at all, and NULL NOT LIKE ... is NULL, which would
    -- filter the row back out.
    AND COALESCE(statement.sql_text, thread.PROCESSLIST_info, '') NOT LIKE '/* otel-collector-ignore */%'
LIMIT {{ .limit }}
