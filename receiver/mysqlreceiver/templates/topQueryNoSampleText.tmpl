{{/* Fallback for MySQL <8 / MariaDB. Keep in sync with topQuery.tmpl — this SELECT is a strict prefix of that one, omitting only the trailing query_sample_text column. */}}
SELECT
    COALESCE(`schema_name`, ''),
    COALESCE(`digest`, ''),
    COALESCE(`digest_text`, ''),
    `count_star`,
    `sum_timer_wait`,
    -- sum_rows_examined/sum_rows_sent are unconditionally safe here: confirmed present
    -- on every supported version (MySQL 5.7.44, MariaDB 10.0.38-11.8.9), no version gate needed.
    `sum_rows_examined`,
    `sum_rows_sent`
FROM performance_schema.events_statements_summary_by_digest
WHERE `last_seen` >= NOW() - INTERVAL {{ .lookbackTime }} second
    AND ((`digest_text` NOT LIKE 'EXPLAIN %' AND `digest_text` NOT LIKE '/* otel-collector-ignore */%')
        OR `digest_text` IS NULL)
ORDER BY `count_star` DESC
LIMIT {{ .topNValue }}
