display_name: PostgreSQL Receiver
type: postgresql

description: |
  This receiver queries the PostgreSQL [statistics collector](https://www.postgresql.org/docs/13/monitoring-stats.html).

status:
  class: receiver
  stability:
    beta: [metrics]
    development: [logs]
  distributions: [contrib]
  codeowners:
    active: [antonblock, ishleenk17, Caleb-Hurshman, ebrdarSplunk, XSAM, akshays-19, sv-splunk, splunk-shanu]
    seeking_new: true
    emeritus: [djaglowski]

reaggregation_enabled: true
override_value_enabled: true

feature_gates:
  - id: postgresqlreceiver.preciselagmetrics
    description: Metric `postgresql.wal.lag` is replaced by more precise `postgresql.wal.delay`.
    stage: beta
    from_version: "v0.89.0"
    reference_url: https://github.com/open-telemetry/opentelemetry-collector-contrib/issues/30831

  - id: receiver.postgresql.connectionPool
    description: Use of connection pooling
    stage: beta
    from_version: "v0.96.0"
    reference_url: https://github.com/open-telemetry/opentelemetry-collector-contrib/issues/30831

  - id: receiver.postgresql.separateSchemaAttr
    description: Moves Schema Names into dedicated Attribute
    stage: alpha
    from_version: "v0.122.0"
    reference_url: https://github.com/open-telemetry/opentelemetry-collector-contrib/issues/29559

  - id: receiver.postgresql.useOTelSemconv
    stage: alpha
    description: >-
      When enabled, uses a single resource per server with a service.instance.id (UUID v5)
      resource attribute, aligning with OpenTelemetry semantic conventions. When disabled,
      uses the legacy per-entity resource model with postgresql.database.name,
      postgresql.table.name, postgresql.index.name, and postgresql.schema.name resource
      attributes.
    from_version: "v0.156.0"
    reference_url: https://github.com/open-telemetry/opentelemetry-collector-contrib/issues/45347

resource_attributes:
{% for attr in (ctx.groups | selectattr("id", "equalto", "resource.attributes") | first).attributes %}  {{ attr.name | safe }}:
    description: {{ attr.brief | safe }}
    enabled: {% if attr.requirement_level == "opt_in" %}false{% else %}true{% endif %}
    type: {{ attr.type | safe }}
{% endfor %}
attributes:
{% for attr in (ctx.groups | selectattr("id", "equalto", "metric.attributes") | first).attributes | sort(attribute="name") %}  {{ attr.name | safe }}:
    description: {{ attr.brief | safe }}
    type: {% if attr.type.members is defined %}string{% else %}{{ attr.type | safe }}{% endif %}
{% if attr.type.members is defined %}    enum:{% for member in attr.type.members %}
      - {{ member.value | safe }}{% endfor %}
{% endif %}{% if attr.annotations and attr.annotations.scraper and attr.annotations.scraper.name_override %}    name_override: {{ attr.annotations.scraper.name_override | safe }}
{% endif %}    requirement_level: {{ attr.requirement_level | safe }}
{% endfor %}
events:
{% for e in ctx.groups | selectattr("type", "equalto", "event") %}  {{ e.name | safe }}:
    enabled: {{ e.annotations.scraper.enabled | safe }}
    description: {{ e.brief | safe }}
    attributes:{% for name in e.annotations.scraper.attribute_order %}
      - {{ name | safe }}{% endfor %}
{% endfor %}
metrics:
{% for m in ctx.groups | selectattr("type", "equalto", "metric") %}  {{ m.id | safe }}:
    description: {{ m.brief | safe }}
    enabled: {{ m.annotations.scraper.enabled | safe }}
    stability: {{ m.stability | safe }}
    {% if m.instrument == "counter" %}sum:
      value_type: {{ m.annotations.scraper.value_type | safe }}
      monotonic: true
      aggregation_temporality: cumulative
    {% elif m.instrument == "updowncounter" %}sum:
      value_type: {{ m.annotations.scraper.value_type | safe }}
      monotonic: false
      aggregation_temporality: cumulative
    {% else %}gauge:
      value_type: {{ m.annotations.scraper.value_type | safe }}
    {% endif %}unit: "{{ m.unit | safe }}"
{% if m.annotations.scraper.attribute_order is defined %}    attributes:{% for name in m.annotations.scraper.attribute_order %}
      - {{ name | safe }}{% endfor %}
{% elif m.attributes %}    attributes:{% for attr in m.attributes %}
      - {{ attr.name | safe }}{% endfor %}
{% endif %}{% if m.note %}    extended_documentation: |
{{ m.note | trim | indent(6, true) | safe }}
{% endif %}{% endfor %}
tests:
  config:
  goleak:
    ignore:
      any:
        - "github.com/cihub/seelog.(*asyncLoopLogger).processQueue" # see https://github.com/cihub/seelog/issues/182
        - "github.com/godbus/dbus.(*Conn).inWorker"
        - github.com/hashicorp/golang-lru/v2/expirable.NewLRU[...].func1
      top:
        # Can be removed once the following issue is resolved:
        # https://github.com/snowflakedb/gosnowflake/issues/1369
        - "github.com/snowflakedb/gosnowflake.initOCSPCacheClearer.func1"
